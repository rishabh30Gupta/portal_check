# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Portals to check ───────────────────────────────────────────────────────────
STAGING_URL=https://stgclient.vetty.co/client/login
DEV_URL=https://devapplicant.vetty.co/

# ── Gmail ──────────────────────────────────────────────────────────────────────
# The Gmail address that sends the alerts
EMAIL_SENDER=hellolucifer007@gmail.com

# App Password for EMAIL_SENDER
# Generate at: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account)
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# The address that receives the alerts
EMAIL_TO=rishabh.gupta@vetty.co

# ── GitHub Gist (state persistence) ───────────────────────────────────────────
# Fine-grained Personal Access Token with "Gists" read+write permission.
# Generate at: https://github.com/settings/tokens?type=beta
#   → New fine-grained token → Repository access: None
#   → Account permissions → Gists → Access: Read and write
GIST_TOKEN=your_github_pat_here

# The ID portion of your Gist URL.
# After creating the Gist, the URL looks like:
#   https://gist.github.com/<username>/<GIST_ID>
# Copy the last path segment (the long hex string) here.
GIST_ID=your_gist_id_here
